# macOS 虚拟机统一配置 —— 所有 setup 脚本都会 source 本文件

# fetch-macOS-v2.py 下载菜单中的匹配名(用于自动选择版本)
MACOS_MENU_NAME="Sonoma"
VM_NAME="macos-sonoma"

# 资源分配(本机:16 线程 / 31GB 内存)
VM_RAM_MB="${VM_RAM_MB:-8192}"  # 默认 8 GiB,避免挤占宿主机内存;可临时覆盖
VM_SMP=4               # vCPU 总数 = cores x threads x sockets(排错中,临时降到4)
VM_CORES=4
VM_THREADS=1

# vmware-svga 显存(默认仅 16 MiB,提高后更适合 1080p 多缓冲)
VIDEO_RAM_MB="${VIDEO_RAM_MB:-64}"

# 系统盘(qcow2 稀疏分配,不立即占满物理磁盘)
VM_DISK_FILE="mac_hdd_ng.img"
VM_DISK_SIZE="256G"

# 网络(user-mode NAT,仅在宿主机回环地址转发到虚拟机)
SSH_HOST_PORT=2222     # 连接: ssh -p 2222 <mac用户>@localhost

# 显示模式:gtk = 本地 QEMU 窗口,交互延迟较低(关窗即杀虚拟机,慎用)
#          vnc = 无头 + VNC(127.0.0.1:5901),关查看器不影响虚拟机
# 可临时切换:DISPLAY_MODE=vnc bash setup/40-boot-macos.sh
DISPLAY_MODE="${DISPLAY_MODE:-gtk}"
VNC_DISPLAY=1          # VNC 显示号,端口 = 5900 + 显示号
