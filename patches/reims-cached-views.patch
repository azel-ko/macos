diff --git a/crates/reims-vgpu/src/runtime/mapper/tests.rs b/crates/reims-vgpu/src/runtime/mapper/tests.rs
index 4458cb30aca55ec1ff683c2548c4e193568e90b1..6dfacf5c84062a42abb8f816e1085683c036742b 100644
--- a/crates/reims-vgpu/src/runtime/mapper/tests.rs
+++ b/crates/reims-vgpu/src/runtime/mapper/tests.rs
@@ -7,6 +7,22 @@
 
 use super::selected_within;
 
+#[test]
+fn disabled_cached_views_cannot_return_an_existing_pointer() {
+    use crate::model::{DeviceId, PAGE_SHIFT_X86};
+    use crate::runtime::host::FakeHost;
+    let mut host = FakeHost::new();
+    let mut state = crate::model::DeviceState::new(DeviceId(1), PAGE_SHIFT_X86);
+    state.map_surface(6);
+    let m = state.mappings.get_mut(&6).unwrap();
+    // A sentinel, never dereferenced: the policy must reject before consulting
+    // cached memory. It must not mutate or release a view behind its owner.
+    m.contig_ptr = 0x1000;
+    m.contig_len = 4096;
+    assert!(super::contig_view_with_policy(&mut state, &mut host, 6, false).is_none());
+    assert_eq!(state.mappings.get(&6).unwrap().contig_ptr, 0x1000);
+}
