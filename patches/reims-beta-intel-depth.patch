+#[cfg(m2v_gpu)]
+mod intel_depth {
+    use crate::{
+        BlitOption, CommandBufferStatus, Device, DeviceKind, DeviceOptions, Origin,
+        ResourceOptions, Size, TextureDescriptor,
+    };
+    use metal2vulkan::metal::{PixelFormat, TextureType, TextureUsage};
+    use std::time::Duration;
+
+    #[test]
+    fn iris_xe_mesa_25_2_8_multisampled_depth_upload() {
+        let device = Device::system_default_with(&DeviceOptions {
+            kinds: vec![DeviceKind::Integrated],
+            ..DeviceOptions::default()
+        })
+        .unwrap();
+        let description = &device.properties().description;
+        assert_eq!(
+            (
+                description.vendor_id,
+                description.device_id,
+                description.driver_version
+            ),
+            (0x8086, 0xa7a0, 0x06402008),
+            "This measurement requires the declared local driver"
+        );
+        let bits: [u32; 32] = [
+            0, 0x80000000, 1, 0x80000001, 0x007fffff, 0x807fffff, 0x00800000, 0x80800000,
+            0x3e800000, 0x3f000000, 0x3f400000, 0x3f800000, 0xbf000000, 0x40000000, 0x7f800000,
+            0xff800000, 0x7fc00000, 0xffc00000, 0x7fc12345, 0xffc12345, 0x3f000001, 0x3effffff,
+            0x3f7fffff, 0x00800001, 0x00010000, 0x80010000, 0x3c000000, 0x3d000000, 0x7f7fffff,
+            0xff7fffff, 0x7f800001, 0xff800001,
+        ];
+        let bytes: Vec<u8> = bits.iter().flat_map(|n| n.to_le_bytes()).collect();
+        let source = device
+            .new_buffer_with_bytes(&bytes, ResourceOptions::shared())
+            .unwrap();
+        let output = device
+            .new_buffer_with_bytes(&vec![0; bytes.len()], ResourceOptions::shared())
+            .unwrap();
+        let mut descriptor = TextureDescriptor::texture_2d(PixelFormat::Depth32Float, 8, 1, false);
+        descriptor.texture_type = TextureType::Type2DMultisample;
+        descriptor.sample_count = 4;
+        descriptor.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+        descriptor.resource_options = ResourceOptions::private();
+        let texture = device.new_texture(&descriptor).unwrap();
+        let queue = device.new_command_queue().unwrap();
+        let command = queue.command_buffer().unwrap();
+        let mut blit = command.blit_command_encoder().unwrap();
+        blit.copy_from_buffer_to_texture(
+            &source,
+            0,
+            128,
+            128,
+            Size::new(8, 1, 1),
+            &texture,
+            0,
+            0,
+            Origin::new(0, 0, 0),
+            BlitOption::None,
+        )
+        .expect("the guest's depth upload must run");
+        blit.end_encoding().unwrap();
+        command.commit().unwrap();
+        command
+            .wait_until_completed_for(Duration::from_secs(30))
+            .unwrap();
+        assert_eq!(command.status(), CommandBufferStatus::Completed);
+        let command = queue.command_buffer().unwrap();
+        let mut blit = command.blit_command_encoder().unwrap();
+        blit.copy_from_texture_to_buffer(
+            &texture,
+            0,
+            0,
+            Origin::new(0, 0, 0),
+            Size::new(8, 1, 1),
+            &output,
+            0,
+            128,
+            128,
+            BlitOption::None,
+        )
+        .unwrap();
+        blit.end_encoding().unwrap();
+        command.commit().unwrap();
+        command
+            .wait_until_completed_for(Duration::from_secs(30))
+            .unwrap();
+        assert_eq!(command.status(), CommandBufferStatus::Completed);
+        // SAFETY: the shared output buffer is live, holds 128 bytes, and both copies completed.
+        let read = unsafe { std::slice::from_raw_parts(output.contents().unwrap().as_ptr(), 128) };
+        for (index, (input, output)) in bits.iter().zip(read.chunks_exact(4)).enumerate() {
+            let actual = u32::from_le_bytes(output.try_into().unwrap());
+            eprintln!("INTEL_DEPTH sample={index} input={input:#010x} actual={actual:#010x}");
+            let value = f32::from_bits(*input);
+            let expected = if value.is_nan() || value.is_sign_negative() || value.is_subnormal() {
+                0
+            } else if value > 1.0 {
+                1.0f32.to_bits()
+            } else {
+                *input
+            };
+            assert_eq!(
+                actual, expected,
+                "measured depth-copy result at sample {index}"
+            );
+        }
+    }
+}
