+        assert!(fragment_depth_changes_for(driver, 0x06402008, 0x8086, 0xa7a0).is_some());
+        for (version, vendor, device) in [
+            (0x06402007, 0x8086, 0xa7a0),
+            (0x06402009, 0x8086, 0xa7a0),
+            (0x06402008, 0x1002, 0xa7a0),
+            (0x06402008, 0x8086, 0x46a6),
+        ] {
+            assert!(fragment_depth_changes_for(driver, version, vendor, device).is_none());
+        }
+        assert!(fragment_depth_changes_for(None, 0x06402008, 0x8086, 0xa7a0).is_none());
+        assert!(fragment_depth_changes_for(
+            Some(DriverId::MESA_LLVMPIPE),
+            0x06402008,
+            0x8086,
+            0xa7a0
+        )
+        .is_none());
+    }
+}
