+
+fn fragment_depth_changes_for(
+    driver: Option<DriverId>,
+    version: u32,
+    vendor: u32,
+    device: u32,
+) -> Option<&'static str> {
+    let driver = driver?;
+    if (driver, version, vendor, device)
+        == (DriverId::INTEL_OPEN_SOURCE_MESA, 0x06402008, 0x8086, 0xa7a0)
+    {
+        // Measured on this exact ANV identity with per-sample buffer upload and
+        // readback: 32 patterns spanning zeros, subnormals, normal unit depths,
+        // out-of-range values, infinities and signed NaN payloads. Do not extend
+        // this record to another GPU or driver release without measuring it.
+        return Some("on Iris Xe RPL-P / ANV Mesa 25.2.8, negative zero, negative values, subnormals and NaNs become +0; values above 1 and +inf become 1; normal finite depths in [0, 1] are kept");
+    }
     FRAGMENT_DEPTH_CHANGES
         .iter()
         .find(|(of, _)| *of == driver)
         .map(|(_, changes)| *changes)
 }
 
